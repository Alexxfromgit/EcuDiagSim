{
  "name": "Snow - ESC at work, then a yaw rate sensor failure",
  "description": "Too fast into a bend on snow: the tyres cannot hold the line, the car turns less than steered. The ESC sees it - steering angle against yaw rate - brakes and asks the ECM for less torque; the ESC lamp flashes. Then the yaw rate sensor fails: the ESC switches off, but the ABS keeps working. Each function degrades on its own.",
  "lesson": "docs/lessons/32-esc-on-snow.md",
  "level": "Advanced",
  "topics": ["ESC", "ABS", "Network"],
  "equipment": ["esc"],
  "steps": [
    { "action": "ignition", "value": "on" },
    { "action": "startEngine" },
    { "action": "waitFor", "signal": "EngineRunning", "op": "==", "value": 1, "timeout": 5000 },
    { "action": "wait", "ms": 3500 },
    { "action": "surface", "value": "snow" },
    { "action": "selector", "value": "D" },
    { "action": "throttle", "value": 80 },
    { "action": "waitFor", "signal": "VehicleSpeed", "op": ">", "value": 60, "timeout": 40000 },
    { "action": "throttle", "value": 40 },
    { "action": "expect", "lamp": "esc", "value": false },

    { "action": "steering", "value": 120, "note": "1. A bend - too fast for snow" },
    { "action": "waitFor", "signal": "EscActive", "op": "==", "value": 1, "timeout": 2000, "note": "2. Yaw rate far below what the steering asks for: understeer. ESC intervenes" },
    { "action": "wait", "ms": 300 },
    { "action": "expect", "lamp": "escFlashing", "value": true, "note": "ESC lamp flashes" },
    { "action": "expect", "signal": "ThrottlePos", "op": "<", "value": 15, "note": "The ECM reduces the torque although the pedal is at 40 %" },
    { "action": "steering", "value": 0 },
    { "action": "waitFor", "signal": "EscActive", "op": "==", "value": 0, "timeout": 3000 },

    { "action": "inject", "target": "yaw", "fault": "open", "note": "3. The yaw rate sensor's connector comes loose" },
    { "action": "wait", "ms": 500 },
    { "action": "expect", "dtc": "C0196-11", "ecu": "ABS", "status": "testFailed", "note": "C0196-11: yaw rate sensor circuit low" },
    { "action": "expect", "signal": "EscOff", "op": "==", "value": 1, "note": "ESC off: without the yaw rate it cannot tell what the car does" },
    { "action": "expect", "lamp": "esc", "value": true },
    { "action": "expect", "lamp": "abs", "value": false, "note": "But no ABS lamp: wheel speeds are all the ABS needs" },
    { "action": "steering", "value": 120 },
    { "action": "wait", "ms": 1500 },
    { "action": "expect", "signal": "EscActive", "op": "==", "value": 0, "note": "4. Same bend: no help any more" },
    { "action": "steering", "value": 0 },
    { "action": "throttle", "value": 0 },
    { "action": "brake", "value": 100 },
    { "action": "waitFor", "signal": "AbsActive", "op": "==", "value": 1, "timeout": 2000, "note": "Full braking on snow: the ABS still works" },
    { "action": "waitFor", "signal": "VehicleSpeed", "op": "<", "value": 1, "timeout": 30000 },
    { "action": "brake", "value": 0 },
    { "action": "selector", "value": "P" },
    { "action": "clearFault", "target": "yaw" }
  ]
}
