{
  "name": "Braking on ice - ABS at work",
  "description": "Full braking on black ice. The ABS lowers the pressure of every wheel that starts to lock and builds it up again, many times a second: AbsActive on the bus, the wheels keep turning and the car can still be steered. Then a wheel speed sensor fault switches the ABS off - the same braking locks the wheels.",
  "lesson": "docs/lessons/30-abs-on-ice.md",
  "level": "Intermediate",
  "topics": ["ABS", "Chassis", "CAN"],
  "steps": [
    { "action": "ignition", "value": "on" },
    { "action": "startEngine" },
    { "action": "waitFor", "signal": "EngineRunning", "op": "==", "value": 1, "timeout": 5000 },
    { "action": "wait", "ms": 3500 },
    { "action": "selector", "value": "D" },
    { "action": "throttle", "value": 60 },
    { "action": "waitFor", "signal": "VehicleSpeed", "op": ">", "value": 50, "timeout": 20000 },
    { "action": "throttle", "value": 0 },
    { "action": "surface", "value": "ice", "note": "1. Black ice ahead" },
    { "action": "brake", "value": 100, "note": "Full braking" },
    { "action": "wait", "ms": 300 },
    { "action": "expect", "signal": "AbsActive", "op": "==", "value": 1, "note": "2. ABS_Status.AbsActive: the pressure is modulated wheel by wheel" },
    { "action": "steering", "value": 60, "note": "Steer round the obstacle: with turning wheels the car follows" },
    { "action": "wait", "ms": 15000 },
    { "action": "expect", "signal": "VehicleSpeed", "op": "<", "value": 1, "note": "Stopped - on ice that takes a long way" },
    { "action": "expect", "dtc": "C0035", "ecu": "ABS", "status": "absent", "note": "ABS working is no fault" },
    { "action": "steering", "value": 0 },
    { "action": "brake", "value": 0 },

    { "action": "surface", "value": "dry", "note": "3. Now the same with the ABS switched off" },
    { "action": "inject", "target": "wss_fl", "fault": "open", "note": "A broken wheel speed sensor: ABS lamp on, ABS off - ordinary brakes only" },
    { "action": "throttle", "value": 60 },
    { "action": "waitFor", "signal": "VehicleSpeed", "op": ">", "value": 40, "timeout": 20000 },
    { "action": "expect", "lamp": "abs", "value": true },
    { "action": "throttle", "value": 0 },
    { "action": "surface", "value": "ice" },
    { "action": "brake", "value": 100 },
    { "action": "wait", "ms": 500 },
    { "action": "expect", "signal": "WheelSpeed_FR", "op": "<", "value": 2, "note": "4. The wheels lock: 0 km/h on the bus while the car still slides - and cannot be steered" },
    { "action": "expect", "signal": "AbsActive", "op": "==", "value": 0 },
    { "action": "wait", "ms": 15000 },
    { "action": "brake", "value": 0 },
    { "action": "selector", "value": "P" },
    { "action": "clearFault", "target": "wss_fl" }
  ]
}
