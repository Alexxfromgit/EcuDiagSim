{
  "name": "After the wheel alignment - steering angle calibration",
  "description": "The alignment shop re-centred the steering wheel, but the steering angle sensor still has the old zero point: driving straight on, it reads 15 degrees. The ESC compares steering angle and yaw rate, finds them implausible (C0460-64) and switches itself off. The calibration routine teaches the sensor its new zero - only at standstill.",
  "lesson": "docs/lessons/31-steering-angle-calibration.md",
  "level": "Intermediate",
  "topics": ["ESC", "Routine control", "Sensors"],
  "equipment": ["esc"],
  "steps": [
    { "action": "inject", "target": "sas", "fault": "unconfigured", "note": "1. Back from the wheel alignment: wheel straight, sensor zero 15 deg off" },
    { "action": "ignition", "value": "on" },
    { "action": "startEngine" },
    { "action": "waitFor", "signal": "EngineRunning", "op": "==", "value": 1, "timeout": 5000 },
    { "action": "wait", "ms": 3500 },
    { "action": "selector", "value": "D" },
    { "action": "throttle", "value": 50 },
    { "action": "waitFor", "signal": "VehicleSpeed", "op": ">", "value": 40, "timeout": 20000 },
    { "action": "throttle", "value": 20 },
    { "action": "expect", "signal": "SteeringAngle", "op": ">", "value": 14, "note": "2. ABS_Chassis: 15 deg steering angle although the car runs straight (yaw rate 0)" },
    { "action": "wait", "ms": 5000 },
    { "action": "expect", "dtc": "C0460-64", "ecu": "ABS", "status": "testFailed", "note": "C0460-64: steering angle sensor, signal plausibility failure" },
    { "action": "expect", "signal": "EscOff", "op": "==", "value": 1, "note": "The ESC switches itself off ..." },
    { "action": "expect", "lamp": "esc", "value": true, "note": "... ESC lamp steady" },
    { "action": "expect", "lamp": "abs", "value": false, "note": "The ABS is not affected" },

    { "action": "unlock", "ecu": "ABS", "note": "3. Calibrate" },
    { "action": "uds", "ecu": "ABS", "request": "31 01 04 01", "expect": "7F 31 22", "note": "Refused while moving: the sensor must learn 'straight' at rest" },
    { "action": "throttle", "value": 0 },
    { "action": "brake", "value": 60 },
    { "action": "waitFor", "signal": "VehicleSpeed", "op": "<", "value": 0.5, "timeout": 20000 },
    { "action": "selector", "value": "P" },
    { "action": "brake", "value": 0 },
    { "action": "unlock", "ecu": "ABS" },
    { "action": "uds", "ecu": "ABS", "request": "31 01 04 01", "expect": "71 01 04 01 02", "note": "Wheels straight, at rest: completed" },
    { "action": "wait", "ms": 100 },
    { "action": "expect", "signal": "SteeringAngle", "op": "<", "value": 0.5 },
    { "action": "uds", "ecu": "ABS", "request": "14 FF FF FF", "expect": "54" },

    { "action": "selector", "value": "D", "note": "4. Test drive" },
    { "action": "throttle", "value": 50 },
    { "action": "waitFor", "signal": "VehicleSpeed", "op": ">", "value": 40, "timeout": 20000 },
    { "action": "throttle", "value": 20 },
    { "action": "wait", "ms": 5000 },
    { "action": "expect", "signal": "EscOff", "op": "==", "value": 0, "note": "ESC back on" },
    { "action": "expect", "dtc": "C0460-64", "ecu": "ABS", "status": "absent" }
  ]
}
