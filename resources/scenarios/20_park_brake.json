{
  "name": "Park brake - driving off with it, and a stuck switch",
  "description": "The hand brake holds the car against a light throttle; with more throttle the car drags itself off and the BCM warns. Then the switch sticks: the BRAKE lamp stays on with the lever released. A plain switch has no plausibility check - no DTC, only the input reading in the BCM live data.",
  "lesson": "docs/lessons/20-park-brake.md",
  "level": "Beginner",
  "topics": ["BCM", "Warning lamps", "Live data"],
  "steps": [
    { "action": "ignition", "value": "on" },
    { "action": "startEngine" },
    { "action": "waitFor", "signal": "EngineRunning", "op": "==", "value": 1, "timeout": 5000 },
    { "action": "wait", "ms": 3500 },
    { "action": "parkBrake", "value": true, "note": "1. Apply the park brake" },
    { "action": "wait", "ms": 300 },
    { "action": "expect", "signal": "ParkBrake", "op": "==", "value": 1 },
    { "action": "expect", "lamp": "parkBrake", "value": true, "note": "Red BRAKE tell-tale" },

    { "action": "selector", "value": "D" },
    { "action": "throttle", "value": 25 },
    { "action": "wait", "ms": 3000 },
    { "action": "expect", "signal": "VehicleSpeed", "op": "<", "value": 0.5, "note": "2. It holds the car against a light throttle" },
    { "action": "throttle", "value": 70 },
    { "action": "waitFor", "signal": "VehicleSpeed", "op": ">", "value": 12, "timeout": 20000, "note": "With more throttle the car drags itself off - slowly" },
    { "action": "wait", "ms": 300 },
    { "action": "expect", "signal": "ParkBrakeWarn", "op": "==", "value": 1, "note": "Above 10 km/h the BCM warns: the lamp flashes" },
    { "action": "throttle", "value": 0 },
    { "action": "brake", "value": 60 },
    { "action": "waitFor", "signal": "VehicleSpeed", "op": "<", "value": 1, "timeout": 15000 },
    { "action": "parkBrake", "value": false },
    { "action": "wait", "ms": 300 },
    { "action": "expect", "lamp": "parkBrake", "value": false },

    { "action": "inject", "target": "park_brake_switch", "fault": "failure", "note": "3. The switch under the lever sticks closed" },
    { "action": "wait", "ms": 300 },
    { "action": "expect", "lamp": "parkBrake", "value": true, "note": "The lamp is on although the brake is released" },
    { "action": "uds", "ecu": "BCM", "request": "22 40 04", "expect": "62 40 04 01", "note": "BCM switch inputs (DID 0x4004): bit 0 says applied" },
    { "action": "uds", "ecu": "BCM", "request": "19 02 08", "expect": "59 02 FF", "note": "No confirmed DTC: nothing can tell a stuck switch from an applied brake" },
    { "action": "brake", "value": 0 },
    { "action": "throttle", "value": 30 },
    { "action": "waitFor", "signal": "VehicleSpeed", "op": ">", "value": 15, "timeout": 15000, "note": "4. The car accelerates normally - the brake is really off ..." },
    { "action": "wait", "ms": 300 },
    { "action": "expect", "signal": "ParkBrakeWarn", "op": "==", "value": 1, "note": "... but the BCM warns anyway" },
    { "action": "throttle", "value": 0 },
    { "action": "brake", "value": 60 },
    { "action": "waitFor", "signal": "VehicleSpeed", "op": "<", "value": 1, "timeout": 15000 },
    { "action": "selector", "value": "P" },
    { "action": "clearFault", "target": "park_brake_switch", "note": "New switch" },
    { "action": "wait", "ms": 300 },
    { "action": "expect", "lamp": "parkBrake", "value": false }
  ]
}
