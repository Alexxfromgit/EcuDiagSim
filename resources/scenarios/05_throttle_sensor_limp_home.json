{
  "name": "Throttle position sensor - limp home",
  "description": "The throttle sensor signal wire shorts to ground. Without trustworthy feedback the ECM limits the throttle to 25 % (limp home), stores P0122 and lights the MIL - the car still drives, but slowly.",
  "lesson": "docs/lessons/05-throttle-limp-home.md",
  "level": "Beginner",
  "topics": ["ECM", "Sensors", "Limp mode"],
  "steps": [
    { "action": "ignition", "value": "on" },
    { "action": "warmUp" },
    { "action": "startEngine" },
    { "action": "waitFor", "signal": "EngineRunning", "op": "==", "value": 1, "timeout": 5000 },
    { "action": "wait", "ms": 3500, "note": "Waiting for the cluster bulb check to finish" },
    { "action": "selector", "value": "D" },
    { "action": "throttle", "value": 60 },
    { "action": "wait", "ms": 1000 },
    { "action": "expect", "signal": "ThrottlePos", "op": ">=", "value": 55, "note": "Healthy: the throttle plate follows the pedal" },
    { "action": "expect", "signal": "EngineLimp", "op": "==", "value": 0 },

    { "action": "inject", "target": "tps", "fault": "short_gnd", "note": "The TPS signal wire chafes through and touches the engine block" },
    { "action": "wait", "ms": 1000 },
    { "action": "expect", "dtc": "P0122", "ecu": "ECM", "status": "confirmed", "note": "1. Below 0.2 V the ECM knows the circuit is broken: P0122 circuit low" },
    { "action": "expect", "signal": "EngineLimp", "op": "==", "value": 1, "note": "2. Limp home: the ECM no longer trusts the sensor" },
    { "action": "expect", "signal": "ThrottlePos", "op": "<=", "value": 25.5, "note": "The throttle is capped at 25 % although the pedal asks for 60 %" },
    { "action": "expect", "signal": "PedalPos", "op": ">=", "value": 59 },
    { "action": "expect", "lamp": "mil", "value": true, "note": "3. P0122 is emission relevant: MIL on" },
    { "action": "uds", "ecu": "ECM", "request": "22 10 02", "expect": "62 10 02 00 00", "note": "4. Sensor voltage read with UDS: 0 mV - a short to ground, not a stuck sensor" },
    { "action": "uds", "ecu": "ALL", "request": "03", "expectContains": "01 22", "note": "OBD Mode 03 shows P0122 to any generic scan tool" },

    { "action": "clearFault", "target": "tps", "note": "Repair the wiring harness" },
    { "action": "wait", "ms": 1000 },
    { "action": "expect", "signal": "EngineLimp", "op": "==", "value": 0, "note": "Limp mode ends as soon as the signal is plausible again" },
    { "action": "expect", "lamp": "mil", "value": true, "note": "The MIL stays on until three good trips or a clear" },
    { "action": "uds", "ecu": "ECM", "request": "14 FF FF FF", "expect": "54" },
    { "action": "wait", "ms": 1000 },
    { "action": "expect", "dtc": "P0122", "ecu": "ECM", "status": "absent" },
    { "action": "expect", "lamp": "mil", "value": false },
    { "action": "throttle", "value": 0 },
    { "action": "brake", "value": 40 },
    { "action": "waitFor", "signal": "VehicleSpeed", "op": "<=", "value": 0.5, "timeout": 30000 },
    { "action": "brake", "value": 0 },
    { "action": "selector", "value": "P" }
  ]
}
