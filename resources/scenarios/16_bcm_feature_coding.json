{
  "name": "Body functions by coding - daytime lights and auto-lock",
  "description": "Many functions are already in the body module and only need switching on. The BCM variant coding (DID 0x0100) holds one bit per function: write bit 2 and the position lamps work as daytime running lights, bit 1 locks the doors above 15 km/h.",
  "lesson": "docs/lessons/16-bcm-feature-coding.md",
  "level": "Beginner",
  "topics": ["BCM", "UDS", "Coding"],
  "steps": [
    { "action": "ignition", "value": "on" },
    { "action": "startEngine" },
    { "action": "waitFor", "signal": "EngineRunning", "op": "==", "value": 1, "timeout": 5000 },
    { "action": "wait", "ms": 1000 },
    { "action": "uds", "ecu": "BCM", "request": "22 01 00", "expect": "62 01 00 01", "note": "1. Coding as delivered: 01 = lamp monitoring only" },
    { "action": "uds", "ecu": "BCM", "request": "22 40 02", "expect": "62 40 02 00", "note": "Exterior lamps (DID 0x4002): all off" },

    { "action": "unlock", "ecu": "BCM", "note": "2. Coding needs the extended session and security access" },
    { "action": "uds", "ecu": "BCM", "request": "2E 01 00 08", "expect": "7F 2E 31", "note": "Bit 3 means nothing to this BCM: requestOutOfRange" },
    { "action": "uds", "ecu": "BCM", "request": "2E 01 00 07", "expect": "6E 01 00", "note": "07 = lamp monitoring + auto-lock + daytime running lights" },
    { "action": "wait", "ms": 300 },
    { "action": "uds", "ecu": "BCM", "request": "22 40 02", "expect": "62 40 02 04", "note": "3. Position lamps on while the engine runs (bit 2 of DID 0x4002)" },

    { "action": "selector", "value": "D" },
    { "action": "throttle", "value": 30 },
    { "action": "waitFor", "signal": "VehicleSpeed", "op": ">", "value": 20, "timeout": 15000, "note": "4. Drive off with the doors unlocked" },
    { "action": "wait", "ms": 500 },
    { "action": "expect", "signal": "DoorLock", "op": "==", "value": 1, "note": "Above 15 km/h the BCM locks the doors" },
    { "action": "throttle", "value": 0 },
    { "action": "brake", "value": 60 },
    { "action": "waitFor", "signal": "VehicleSpeed", "op": "<", "value": 1, "timeout": 15000 },
    { "action": "selector", "value": "P" },
    { "action": "input", "name": "doorFL", "value": true, "note": "5. Opening a door ends the auto-lock" },
    { "action": "wait", "ms": 300 },
    { "action": "expect", "signal": "DoorLock", "op": "==", "value": 0 },
    { "action": "input", "name": "doorFL", "value": false },

    { "action": "ignition", "value": "off", "note": "6. The coding is non-volatile: it survives an ignition cycle" },
    { "action": "wait", "ms": 1000 },
    { "action": "ignition", "value": "on" },
    { "action": "wait", "ms": 500 },
    { "action": "uds", "ecu": "BCM", "request": "22 01 00", "expect": "62 01 00 07" }
  ]
}
